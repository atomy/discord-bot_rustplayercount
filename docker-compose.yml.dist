services:
  rustplayercount-bot:
    image: <ecr-registry>/atomy/discord-bot_rustplayercount:latest
    deploy:
      restart_policy:
        condition: on-failure
        delay: 10s
        max_attempts: 10
        window: 120s
    environment:
        DISCORD_API_KEY: '<discord-api-key>'
        SERVER_IP: '<server-ip>'
        SERVER_RCONPORT: '<server-rconport>'
        SERVER_RCONPASSWORD: '<server-rconpassword>'
